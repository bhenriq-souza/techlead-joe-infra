logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

discovery.relabel "ollama" {
  targets = discovery.docker.containers.targets

  // Mantem apenas o container do Ollama
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/ai-lab-ollama"
    action        = "keep"
  }

  // Labels fixas para facilitar queries no Loki/Grafana
  rule {
    target_label = "job"
    replacement  = "ai-lab/ollama"
  }

  rule {
    target_label = "host"
    replacement  = "ai-lab"
  }

  rule {
    target_label = "service"
    replacement  = "ollama"
  }

  rule {
    target_label = "runtime"
    replacement  = "docker-compose"
  }

  rule {
    target_label = "env"
    replacement  = "lab"
  }

  // Normaliza o nome do container
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // stdout / stderr
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "ollama" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.ollama.output
  refresh_interval = "10s"
  forward_to       = [loki.write.homelab.receiver]
}

loki.write "homelab" {
  endpoint {
    url = env("LOKI_PUSH_URL")
  }
}