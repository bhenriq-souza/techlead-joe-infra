# =============================================================================
# AI Lab — .env.example
# =============================================================================
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
#
# O arquivo .env NAO deve ser commitado (esta no .gitignore).
# Este .env.example SIM deve ser versionado como referencia.
# =============================================================================

# -----------------------------------------------------------------------------
# Portas expostas — binding 0.0.0.0 (LAN)
# Acessiveis pelo Cluster B via IP LAN da workstation (192.168.15.103)
# -----------------------------------------------------------------------------
OLLAMA_PORT=11434
TEI_PORT=8080

# -----------------------------------------------------------------------------
# Modelo LLM para Ollama
# RTX 5070 12 GB VRAM — suporta modelos 7B-14B sem restricao de VRAM
# Opcoes recomendadas:
#   qwen2.5:7b  [padrao — bom equilibrio qualidade/velocidade]
#   llama3.1:8b [alternativa]
#   qwen2.5:14b [se quiser mais qualidade, ocupa ~9 GB VRAM]
#
# O modelo NAO e baixado automaticamente pelo compose.
# Baixar manualmente apos subir o stack:
#   docker exec ai-lab-ollama ollama pull qwen2.5:7b
# -----------------------------------------------------------------------------
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# -----------------------------------------------------------------------------
# Modelo de embeddings para TEI
# RTX 5070 12 GB VRAM — suporta modelos de embedding maiores
# Opcoes recomendadas:
#   BAAI/bge-m3             [padrao — multilingual, suporta pt-BR, dense+sparse, ~1.1 GB]
#   nomic-ai/nomic-embed-text-v1.5  [alternativa — 768d, bom para ingles]
#
# O modelo e baixado automaticamente pelo TEI no primeiro start.
# -----------------------------------------------------------------------------
TEI_MODEL_ID=BAAI/bge-m3

# -----------------------------------------------------------------------------
# Token HuggingFace Hub
# Necessario apenas para modelos privados ou gated.
# Para bge-m3 e nomic-embed-text-v1.5 (publicos), deixar vazio.
# NAO passar token vazio — o hf-hub falha com string vazia (ver CONTEXT.md)
# -----------------------------------------------------------------------------
HF_TOKEN=

# -----------------------------------------------------------------------------
# URLs base para consumidores externos (Cluster B, scripts de validacao)
# IP LAN fixo da workstation ai-lab (DHCP reservado, ver environments.md)
# -----------------------------------------------------------------------------
LLM_BASE_URL=http://192.168.15.103:11434
EMBEDDING_BASE_URL=http://192.168.15.103:8080
