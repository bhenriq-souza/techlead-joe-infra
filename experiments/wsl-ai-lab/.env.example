# =============================================================================
# MODO DE TESTE WSL — .env.example
# =============================================================================
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
#
# O arquivo .env NAO deve ser commitado (esta no .gitignore).
# Este .env.example SIM deve ser versionado como referencia.
# =============================================================================

# -----------------------------------------------------------------------------
# Portas expostas (somente localhost neste experimento)
# -----------------------------------------------------------------------------
OLLAMA_PORT=11434
TEI_PORT=8080

# -----------------------------------------------------------------------------
# Modelo LLM para Ollama
# Caminho GPU (laptop, 4GB VRAM): qwen2.5:1.5b  [recomendado] ou llama3.2:1b
# Caminho GPU (workstation, 12GB VRAM): qwen2.5:7b ou llama3.1:8b
#
# O modelo NAO e baixado automaticamente pelo compose.
# Baixar manualmente apos subir o stack:
#   docker exec wsl-ai-lab-ollama ollama pull qwen2.5:1.5b
# -----------------------------------------------------------------------------
OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b

# -----------------------------------------------------------------------------
# Modelo de embeddings para TEI
# Caminho CPU (este teste WSL): BAAI/bge-small-en-v1.5  [recomendado]
#   alternativa: sentence-transformers/all-MiniLM-L6-v2
# Caminho GPU (workstation): nomic-ai/nomic-embed-text-v1.5
#   alternativa: BAAI/bge-m3
#
# O modelo e baixado automaticamente pelo TEI no primeiro start.
# -----------------------------------------------------------------------------
TEI_MODEL_ID=BAAI/bge-small-en-v1.5

# -----------------------------------------------------------------------------
# Token HuggingFace Hub
# Necessario apenas para modelos privados ou gated (ex: Llama 3 sem aceite).
# Para modelos publicos (bge-small, MiniLM, qwen, nomic), deixar vazio.
# -----------------------------------------------------------------------------
HF_TOKEN=

# -----------------------------------------------------------------------------
# URLs base para consumidores (clientes externos, scripts de validacao)
# Manter 127.0.0.1 neste experimento WSL (sem exposicao LAN).
# Na workstation oficial: substituir por IP da LAN.
# -----------------------------------------------------------------------------
LLM_BASE_URL=http://127.0.0.1:11434
EMBEDDING_BASE_URL=http://127.0.0.1:8080
